# Environment Configuration Template for Notify Application
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Database Configuration
DB_SERVER=your-sql-server-hostname
DB_PORT=1433
DB_NAME=webPortal
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# LDAP Configuration
LDAP_SERVER=your-ldap-server-hostname
LDAP_PORT=389
LDAP_DOMAIN=your-domain.com

# Application Settings
APP_NAME=Notify
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Security Settings
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Logging
LOG_LEVEL=warning
LOG_PATH=/var/log/notify/

# Email Configuration (if needed)
MAIL_HOST=smtp.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls

# File Upload Settings
MAX_UPLOAD_SIZE=50M
UPLOAD_PATH=/var/www/html/notify/uploads/

# Cache Settings (if implementing caching)
CACHE_DRIVER=file
CACHE_PATH=/tmp/notify_cache/